{"video_id": "6ULZr-ZtDqc", "label": "Road trip moto Croatie, 2024 l'île de Pag", "segments": [{"start": 0.12, "duration": 7.08, "text": "et prendre cette journée de repos."}, {"start": 7.2, "duration": 8.44, "text": "Où suis-je ?"}, {"start": 10.6, "duration": 8.52, "text": "Paysage lunaire, roche calcaire érodée,"}, {"start": 15.64, "duration": 5.56, "text": "décor de film de science-fiction."}, {"start": 19.12, "duration": 4.96, "text": "L'île de Pague offre des formations"}, {"start": 21.2, "duration": 6.32, "text": "rocheuses spectaculaires, des plateaux"}, {"start": 24.08, "duration": 5.8, "text": "caillouux, pleines arides."}, {"start": 27.52, "duration": 5.24, "text": "Bien que la douceur apparente de l'eau"}, {"start": 29.88, "duration": 4.52, "text": "turquoise de la mer adhériatique tempère"}, {"start": 32.76, "duration": 4.48, "text": "parfois l'aspect sauvage de ces"}, {"start": 34.4, "duration": 6.44, "text": "paysages."}, {"start": 37.24, "duration": 6.64, "text": "La Bura, un vent violent et froid"}, {"start": 40.84, "duration": 5.64, "text": "sculpte chaque rocher."}, {"start": 43.88, "duration": 5.64, "text": "des seuls conférent est atmosphère"}, {"start": 46.48, "duration": 5.57, "text": "sauvage et inhospitalière mais"}, {"start": 49.52, "duration": 8.74, "text": "franchement fascinante."}]}